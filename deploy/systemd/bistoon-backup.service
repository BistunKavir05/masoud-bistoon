# /etc/systemd/system/bistoon-backup.service  — پشتیبان‌گیری از پایگاه‌داده (با bistoon-backup.timer هر شب)
[Unit]
Description=Bistoon database backup
After=postgresql.service

[Service]
Type=oneshot
User=bistoon
Group=bistoon
EnvironmentFile=/etc/bistoon/bistoon.env
ExecStart=/opt/bistoon/deploy/scripts/backup.sh /var/backups/bistoon 30
