# ───── تنظیمات استقرار با Docker Compose ─────
# این فایل را به «.env» کپی کنید (cp .env.example .env) و مقادیر را پر کنید. فایل .env را در مخزن نگذارید.

# گذرواژه‌ی پایگاه‌داده؛ فقط نویسه‌های امن برای نشانی (حرف/رقم). نمونه: openssl rand -hex 24
POSTGRES_PASSWORD=
POSTGRES_USER=bistoon
POSTGRES_DB=bistoon

# پورت و نشانی انتشار روی سرور. پشت nginx: 127.0.0.1 ؛ دسترسی مستقیم از شبکه‌ی داخلی: 0.0.0.0
BISTOON_BIND=127.0.0.1
BISTOON_PORT=3000

# پشت HTTPS حتماً true (کوکی نشست فقط روی HTTPS فرستاده می‌شود). روی HTTP ساده false بماند وگرنه ورود ممکن نیست.
COOKIE_SECURE=false

# پشت nginx/پروکسی روی همان سرور: loopback  (برای محدودکننده‌ی تلاش‌های ورود تا نشانی واقعی کاربر دیده شود). بدون پروکسی: خالی.
TRUST_PROXY=

# مبداهای اضافی مجاز برای درخواست‌های تغییردهنده، با ویرگول (مثلاً https://bistoon.example.ir). معمولاً خالی کافی است.
ALLOWED_ORIGINS=

# عمر نشست به ساعت و سقف اندازه‌ی بدنه‌ی درخواست (باید با client_max_body_size در nginx هم‌خوان باشد)
SESSION_TTL_HOURS=12
BODY_LIMIT=16mb
